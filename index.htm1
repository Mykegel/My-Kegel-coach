<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#16a085">
  <title>My Kegel Coach</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f2f7f6;
      color: #1f2937;
    }

    .app {
      max-width: 500px;
      margin: auto;
      min-height: 100vh;
      background: white;
    }

    header {
      background: #16a085;
      color: white;
      padding: 25px 20px;
      text-align: center;
    }

    header h1 {
      margin: 0;
      font-size: 28px;
    }

    header p {
      margin: 8px 0 0;
      opacity: 0.9;
    }

    .content {
      padding: 20px;
    }

    .card {
      background: white;
      border-radius: 18px;
      padding: 20px;
      margin-bottom: 18px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      text-align: center;
    }

    .timer {
      font-size: 64px;
      font-weight: bold;
      margin: 20px 0 5px;
      color: #16a085;
    }

    .phase {
      font-size: 25px;
      font-weight: bold;
      margin: 10px;
    }

    .instruction {
      color: #6b7280;
      margin-bottom: 20px;
    }

    button {
      border: none;
      border-radius: 12px;
      padding: 15px 25px;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
      margin: 5px;
    }

    .start {
      background: #16a085;
      color: white;
      width: 85%;
    }

    .stop {
      background: #e74c3c;
      color: white;
      width: 85%;
    }

    .reset {
      background: #e5e7eb;
      color: #333;
    }

    .progress-bar {
      height: 15px;
      background: #e5e7eb;
      border-radius: 20px;
      overflow: hidden;
      margin-top: 12px;
    }

    .progress {
      height: 100%;
      width: 0%;
      background: #16a085;
      transition: width 0.3s;
    }

    .stats {
      display: flex;
      justify-content: space-around;
      text-align: center;
    }

    .stat-number {
      font-size: 28
