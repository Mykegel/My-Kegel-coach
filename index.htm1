<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My-Kegel-Coach</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #172033;
    }

    .app {
      max-width: 500px;
      margin: auto;
      padding: 25px 18px 40px;
    }

    h1 {
      text-align: center;
      margin-bottom: 8px;
      font-size: 30px;
    }

    .subtitle {
      text-align: center;
      color: #667085;
      line-height: 1.5;
      margin-bottom: 25px;
    }

    .card {
      background: white;
      border-radius: 20px;
      padding: 25px;
      margin-bottom: 18px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.07);
      text-align: center;
    }

    .phase {
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 10px;
    }

    .timer {
      font-size: 70px;
      font-weight: bold;
      margin: 15px 0;
    }

    .instruction {
      color: #667085;
      min-height: 24px;
    }

    button {
      width: 100%;
      border: none;
      border-radius: 14px;
      padding: 16px;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 10px;
    }

    .start {
      background: #1769e0;
      color: white;
    }

    .stop {
      background: #e9edf5;
      color: #172033;
    }

    .progress-bar {
      width: 100%;
      height: 14px;
      background: #e5e7eb;
      border-radius: 10px;
      overflow: hidden;
      margin-top: 12px;
    }

    .progress {
      height: 100%;
      width: 0%;
      background: #1769e0;
      transition: width 0.3s;
    }

    .stats {
      display: flex;
      justify-content: space-around;
      margin-top: 15px;
    }

    .stat-number {
      font-size: 28px;
      font-weight: bold;
    }

    .stat-label {
      color: #667085;
      font-size: 14px;
    }

    .notice {
      font-size: 13px;
      color: #667085;
      line-height: 1.5;
      margin-top: 20px;
      text-align: center;
    }
  </style>
</head>

<body>

<div class="app">

  <h1>My-Kegel-Coach</h1>

  <div class="subtitle">
    A simple guided Kegel exercise trainer for men.
  </div>

  <div class="card">

    <div class="phase" id="phase">
      Ready
    </div>

    <div class="timer" id="timer">
      5
    </div>

    <div class="instruction" id="instruction">
      Press Start when you are ready.
    </div>

    <button class="start" id="startButton" onclick="startWorkout()">
      ▶️ Start Exercise
    </button>

    <button class="stop" onclick="stopWorkout()">
      ■ Stop
    </button>

  </div>


  <div class="card">

    <h2>Today's Progress</h2>

    <div class="stats">

      <div>
        <div class="stat-number" id="todayCount">0</div>
        <div class="stat-label">Sessions</div>
      </div>

      <div>
        <div class="stat-number" id="streak">0</div>
        <div class="stat-label">Day Streak</div>
      </div>

    </div>

    <div class="progress-bar">
      <div class="progress" id="progress"></div>
    </div>

    <p id="progressText">0 / 10 contractions</p>

  </div>


  <div class="card">

    <h2>Workout</h2>

    <p>
      10 contractions
    </p>

    <p>
      Squeeze for 5 seconds
    </p>

    <p>
      Relax for 5 seconds
    </p>

  </div>

  <div class="notice">
    Stop if you experience pain or discomfort. This app is for exercise guidance
    and does not replace medical advice.
  </div>

</div>


<script>

let timer;
let seconds = 5;
let contraction = 0;
let phase = "squeeze";
let running = false;

const TOTAL = 10;


// Load saved data
let savedSessions =
  Number(localStorage.getItem("kegelSessions")) || 0;

let savedContractions =
  Number(localStorage
